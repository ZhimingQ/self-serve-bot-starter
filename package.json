{
  "name": "self-serve-bot-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Next.js starter: resellers deploy this so each of their end-users gets their own AI bot to chat with, powered by OpenClaw Launch's Build & Resell API.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test:locale": "node --experimental-strip-types --test lib/localeConfig.test.mjs",
    "test:store": "tsx --test lib/store.test.mjs lib/store.adversarial.test.mjs lib/storeUpstash.test.mjs",
    "test:session": "tsx --test lib/session.test.mjs",
    "test:security": "tsx --test lib/payment.test.mjs lib/rateLimit.test.mjs",
    "test:workspace": "node --experimental-strip-types --test lib/customerWorkspace.test.mjs lib/workspaceMode.test.mjs lib/chatMarkdown.test.mjs lib/studentTutor.test.mjs lib/activeTurns.test.mjs lib/elapsed.test.mjs lib/landingFeatures.test.mjs",
    "test:bottools": "node --experimental-strip-types --test lib/botTools.test.mjs",
    "test:reset": "tsx --import ./lib/registerTestHooks.mjs --test lib/passwordReset.test.mjs lib/passwordReset.unconfigured.test.mjs lib/passwordReset.appurl.test.mjs scripts/reset-password.test.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
